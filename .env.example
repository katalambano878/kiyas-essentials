# === Core ===
DATABASE_URL=postgresql://user:password@host:5432/store_kiyas
POSTGRES_URL=
AUTH_JWT_SECRET=change-me-long-random
JWT_SECRET=
NEXT_PUBLIC_APP_URL=https://kiyasessentials.store
NEXT_PUBLIC_USE_PLAIN_PG=true

# Compat shim (legacy names — values are local, not hosted Supabase)
NEXT_PUBLIC_SUPABASE_URL=https://kiyasessentials.store
NEXT_PUBLIC_SUPABASE_ANON_KEY=local-anon-key
SUPABASE_SERVICE_ROLE_KEY=local-service-role-key
SUPABASE_JWT_SECRET=

# Storage (local disk)
STORAGE_ROOT=/app/storage
STORAGE_PUBLIC_URL=https://kiyasessentials.store
STORAGE_SIGNING_SECRET=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=
ADMIN_EMAIL=admin@kiyasessentials.store
CONTACT_PHONE=

# Moolre payments
MOOLRE_API_USER=
MOOLRE_API_PUBKEY=
MOOLRE_ACCOUNT_NUMBER=
MOOLRE_MERCHANT_EMAIL=admin@kiyasessentials.store
MOOLRE_CALLBACK_SECRET=

# Moolre SMS
MOOLRE_SMS_API_KEY=
MOOLRE_API_KEY=
SMS_SENDER_ID=Kiyas

# Cron
CRON_SECRET=

# Optional
PG_POOL_MAX=10
PGSSL=
RECAPTCHA_SECRET_KEY=
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
